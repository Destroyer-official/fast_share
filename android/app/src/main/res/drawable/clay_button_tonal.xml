<?xml version="1.0" encoding="utf-8"?>
<!-- Tonal secondary clay pill — quiet companion to the primary action. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/glass_surface_light" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <solid android:color="@color/glass_surface_tonal" />
                    <stroke android:width="1dp" android:color="@color/glass_stroke_subtle" />
                </shape>
            </item>
            <item android:gravity="top|fill_horizontal" android:left="16dp" android:right="16dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <size android:width="1dp" android:height="1dp" />
                    <solid android:color="@color/clay_inner_hi" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
