<?xml version="1.0" encoding="utf-8"?>
<!-- Clay hero tile (bento span-2): soft vertical gradient body, 28dp corners,
     accent-kissed rim, strong inner top highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/clay_hero_start"
                android:endColor="@color/clay_hero_end" />
            <stroke android:width="1dp" android:color="@color/glass_stroke_subtle" />
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:left="18dp" android:right="18dp" android:top="1dp">
        <shape android:shape="rectangle">
            <size android:width="1dp" android:height="1.5dp" />
            <solid android:color="@color/clay_inner_hi" />
        </shape>
    </item>
</layer-list>
