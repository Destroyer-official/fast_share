<?xml version="1.0" encoding="utf-8"?>
<!-- Hero FAB — the single primary action of the app (Upload).
     Gradient clay orb with specular crown and glow rim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="@color/accent_pulse_pressed"
                        android:endColor="@color/accent_pulse" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Glow rim -->
            <item>
                <shape android:shape="oval">
                    <stroke android:width="1.5dp" android:color="@color/glass_stroke_glow" />
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="@color/accent_pulse"
                        android:endColor="@color/accent_pulse_end" />
                </shape>
            </item>
            <!-- Specular crown -->
            <item android:gravity="top|fill_horizontal" android:left="14dp" android:right="14dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <size android:width="1dp" android:height="1.5dp" />
                    <solid android:color="#66FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
