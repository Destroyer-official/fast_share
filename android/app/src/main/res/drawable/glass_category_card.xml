<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#0A000000" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <corners android:radius="17dp" />
            <gradient
                android:angle="90"
                android:startColor="#1E162B46"
                android:endColor="#28224068" />
            <stroke
                android:width="1dp"
                android:color="#28FFFFFF" />
        </shape>
    </item>
</layer-list>
