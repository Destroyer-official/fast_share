<?xml version="1.0" encoding="utf-8"?>
<!-- Small liquid-glass chip (capsule): icon buttons, breadcrumbs, pills. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/glass_stroke"
                android:endColor="@color/glass_stroke_subtle" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/glass_surface" />
        </shape>
    </item>
</layer-list>
