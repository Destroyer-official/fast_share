<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ambient glow / shadow -->
    <item>
        <shape>
            <corners android:radius="26dp" />
            <solid android:color="#0A38BDF8" />
        </shape>
    </item>
    <!-- Liquid Glass Body -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <corners android:radius="25dp" />
            <gradient
                android:angle="315"
                android:startColor="#251E3860"
                android:centerColor="#1B142A45"
                android:endColor="#120A1E30" />
            <stroke
                android:width="1.5dp"
                android:color="#35FFFFFF" />
        </shape>
    </item>
</layer-list>
