<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Aurora Backing -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="32dp"
                android:topRightRadius="32dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#2538BDF8"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
    <!-- Frosted Acrylic Solid Sheet Layer -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="31dp"
                android:topRightRadius="31dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <solid android:color="#141E3AD9" />
            <stroke
                android:width="1.2dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
    <!-- Top Edge Specular Glow Inset -->
    <item android:top="2dp" android:left="32dp" android:right="32dp" android:bottom="400dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="30dp"
                android:topRightRadius="30dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#30FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
