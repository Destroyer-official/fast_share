<?xml version="1.0" encoding="utf-8"?>
<!-- Tonal avatar orb — device icons, permission tile icons. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/glass_surface_tonal" />
            <stroke android:width="1dp" android:color="@color/glass_stroke_subtle" />
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:left="8dp" android:right="8dp" android:top="1dp">
        <shape android:shape="rectangle">
            <size android:width="1dp" android:height="1dp" />
            <solid android:color="@color/clay_inner_hi" />
        </shape>
    </item>
</layer-list>
