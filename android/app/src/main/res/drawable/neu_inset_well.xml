<?xml version="1.0" encoding="utf-8"?>
<!-- Neumorphic inset well — the ONE legitimate neu surface: the search field.
     Pressed INTO the canvas: dark inner shadow top-left, faint light catch
     bottom-right. Text inside keeps ≥7:1 contrast, so the style never
     carries legibility. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="@color/input_surface" />
                    <stroke android:width="1.5dp" android:color="@color/glass_stroke_focused" />
                </shape>
            </item>
            <item android:gravity="top|fill_horizontal" android:left="10dp" android:right="10dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <size android:width="1dp" android:height="2dp" />
                    <solid android:color="@color/neu_shadow_dark" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="@color/input_surface" />
                </shape>
            </item>
            <!-- Inner shadow: top -->
            <item android:gravity="top|fill_horizontal" android:left="10dp" android:right="10dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <size android:width="1dp" android:height="2dp" />
                    <solid android:color="@color/neu_shadow_dark" />
                </shape>
            </item>
            <!-- Inner shadow: left edge -->
            <item android:gravity="left|fill_vertical" android:left="1dp" android:top="10dp" android:bottom="10dp">
                <shape android:shape="rectangle">
                    <size android:width="2dp" android:height="1dp" />
                    <solid android:color="@color/neu_shadow_dark" />
                </shape>
            </item>
            <!-- Light catch: bottom -->
            <item android:gravity="bottom|fill_horizontal" android:left="10dp" android:right="10dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <size android:width="1dp" android:height="1dp" />
                    <solid android:color="@color/neu_shadow_light" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
