<?xml version="1.0" encoding="utf-8"?>
<!-- Elevated clay sheet — server settings. Top-rounded, specular rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp"
                android:bottomLeftRadius="28dp" android:bottomRightRadius="28dp" />
            <solid android:color="@color/glass_surface_sheet" />
            <stroke android:width="1dp" android:color="@color/glass_stroke_subtle" />
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:left="18dp" android:right="18dp" android:top="1dp">
        <shape android:shape="rectangle">
            <size android:width="1dp" android:height="1.5dp" />
            <solid android:color="@color/glass_stroke_specular" />
        </shape>
    </item>
</layer-list>
