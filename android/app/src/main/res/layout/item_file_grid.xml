<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/clay_card"
    android:elevation="@dimen/z_card"
    android:outlineSpotShadowColor="@color/clay_shadow_tint"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:minHeight="196dp"
    android:padding="12dp">

    <!-- Inset thumbnail well -->
    <FrameLayout
        android:id="@+id/thumbContainer"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:contentDescription="File preview"
        android:background="@drawable/thumb_well"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvFolderIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📁"
            android:textSize="40sp" />

        <!-- Video badge -->
        <FrameLayout
            android:id="@+id/videoBadge"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="@drawable/glass_circle_btn"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_arrow"
                android:tint="@color/accent_cyan" />
        </FrameLayout>
    </FrameLayout>

    <!-- File title -->
    <TextView
        android:id="@+id/tvFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        tools:text="Camera" />

    <!-- Meta -->
    <TextView
        android:id="@+id/tvFileMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.03"
        android:textColor="@color/text_subtle"
        android:textSize="10sp"
        tools:text="DIRECTORY • 22/9/2026" />

    <!-- Action pill -->
    <TextView
        android:id="@+id/btnAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/glass_pill_cyan"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:minWidth="72dp"
        android:minHeight="36dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="Open"
        android:textColor="@color/text_cyan"
        android:textSize="11sp"
        tools:ignore="HardcodedText" />

</LinearLayout>
